<Window x:Class="CoreLauncher.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Core Launcher" Width="600" Height="340" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgDeep}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Pixel}" Icon="Assets/core.ico" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border BorderBrush="{DynamicResource Accent}" BorderThickness="3">
        <Grid ClipToBounds="True">
            <!-- фон: тот же уютный интерьер, затемнённый -->
            <Image Source="Assets/bg_play.jpg" Stretch="UniformToFill" Opacity="0.55"/>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CC120A05" Offset="0"/>
                        <GradientStop Color="#80120A05" Offset="0.5"/>
                        <GradientStop Color="#EE120A05" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- полоска-бревно сверху -->
            <Border Height="22" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="NearestNeighbor">
                <Border.Background>
                    <ImageBrush ImageSource="Assets/spruce_log.png" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,80,160" Stretch="Fill"/>
                </Border.Background>
            </Border>

            <Grid Margin="40,50,40,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CORE" FontSize="52" Foreground="{StaticResource Text}"/>
                        <TextBlock Text="LAUNCHER" FontSize="22" Foreground="{DynamicResource Accent}" Margin="2,-6,0,0"/>
                    </StackPanel>
                    <ContentControl x:Name="FireHost" Margin="26,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="Tip" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,0,10" Text="Сначала уют, потом игра"/>
                    <!-- полоса из пиксельных блоков -->
                    <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="2" Padding="3" CornerRadius="3">
                        <UniformGrid x:Name="Blocks" Rows="1" Height="16"/>
                    </Border>
                    <Grid Margin="0,8,0,0">
                        <TextBlock x:Name="Step" FontSize="13" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="Ver" FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
