<Window x:Class="CoreLauncher.DocWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Core Launcher" Width="760" Height="600" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgDeep}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Pixel}" Icon="Assets/core.ico" UseLayoutRounding="True">
    <Border BorderBrush="{DynamicResource Accent}" BorderThickness="3">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border MouseLeftButtonDown="Drag" RenderOptions.BitmapScalingMode="NearestNeighbor">
                <Border.Background>
                    <ImageBrush ImageSource="Assets/spruce_log.png" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,80,160" Stretch="Fill"/>
                </Border.Background>
                <Button Style="{StaticResource WinButton}" Content="✕" HorizontalAlignment="Right" Width="40" Height="26" Click="Close_Click"/>
            </Border>
            <TextBox x:Name="Body" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" FontSize="15" VerticalScrollBarVisibility="Auto"
                     Margin="18,14,10,8" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Top">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost"/></ControlTemplate>
                </TextBox.Template>
            </TextBox>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,6,18,16">
                <TextBlock x:Name="Note" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Style="{StaticResource GhostButton}" Content="Закрыть" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
