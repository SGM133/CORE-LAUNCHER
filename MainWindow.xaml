<Window x:Class="CoreLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Core Launcher" Width="1140" Height="720" MinWidth="1140" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" Icon="Assets/core.ico" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Плитка скина/плаща в библиотеке -->
        <DataTemplate x:Key="LibTile">
            <Button Click="LibTile_Click" Tag="{Binding Path}" Cursor="Hand" Margin="0,0,10,10" Width="92" ToolTip="{Binding Name}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="2"
                                CornerRadius="4" Padding="6">
                            <StackPanel>
                                <Image Source="{Binding Thumb}" Height="64" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Active}" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHi}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Боковая панель (цвет иконки) ============ -->
            <Border Background="{StaticResource Navy}" MouseLeftButtonDown="DragWindow">
                <Grid Margin="18,24,18,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,30">
                            <Image Source="Assets/logo.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="CORE" FontFamily="{StaticResource Pixel}" FontSize="26" FontWeight="Normal"/>
                                <TextBlock Text="LAUNCHER" FontFamily="{StaticResource Pixel}" FontSize="12" Foreground="{DynamicResource Accent}"/>
                            </StackPanel>
                        </StackPanel>
                        <RadioButton x:Name="NavPlay" Style="{StaticResource NavButton}" Content="▶  Играть" IsChecked="True" Checked="Nav_Click" Tag="Play"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="▦  Профили" Checked="Nav_Click" Tag="Profiles"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="◆  Моды" Checked="Nav_Click" Tag="Mods"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="☻  Скины" Checked="Nav_Click" Tag="Skins"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="⚙  Настройки" Checked="Nav_Click" Tag="Settings"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="4,0,0,0">
                        <TextBlock Text="Сначала уют," FontFamily="{StaticResource Pixel}" FontSize="15" Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text="потом игра" FontFamily="{StaticResource Pixel}" FontSize="15" Foreground="{DynamicResource Accent}"/>
                        <Button x:Name="UpdateBtn" Style="{StaticResource GhostButton}" Visibility="Collapsed" Margin="0,10,0,0" Click="Update_Click"/>
                        <TextBlock x:Name="VersionText" FontSize="11" Foreground="#9AA6E0" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Контент ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Canvas x:Name="StarsCanvas" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True"/>

                <Grid MouseLeftButtonDown="DragWindow" Background="Transparent">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource WinButton}" Content="—" Click="Minimize_Click"/>
                        <Button Style="{StaticResource WinButton}" Content="✕" Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ===== ИГРАТЬ ===== -->
                <Grid x:Name="PagePlay" Grid.Row="1" Margin="40,4,36,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Сначала уют," Style="{StaticResource H1}" FontSize="44"/>
                                <TextBlock Text="потом игра" Style="{StaticResource H1}" FontSize="44" Foreground="{DynamicResource Accent}"/>
                                <TextBlock x:Name="GreetText" Style="{StaticResource Hint}" FontSize="14" Margin="0,10,0,0"/>
                            </StackPanel>
                            <ContentControl x:Name="CampfireHost" Grid.Column="1" Margin="0,0,24,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Style="{StaticResource CardBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="АККАУНТ"/>
                                    <Border Background="{StaticResource Field}" CornerRadius="4" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,12"
                                            BorderBrush="{StaticResource Line}" BorderThickness="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ModeOffline" Style="{StaticResource SegButton}" Content="Офлайн" Click="Mode_Click"/>
                                            <RadioButton x:Name="ModeMs" Style="{StaticResource SegButton}" Content="Microsoft" Click="Mode_Click"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel x:Name="OfflinePanel">
                                        <TextBox x:Name="NickBox" MaxLength="16"/>
                                    </StackPanel>
                                    <StackPanel x:Name="MsPanel" Visibility="Collapsed">
                                        <TextBlock x:Name="MsStatus" Text="Вход ещё не выполнен" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Войти через Microsoft" HorizontalAlignment="Left" Click="MsLogin_Click"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Label}" Text="ПРОФИЛЬ"/>
                                    <ComboBox x:Name="ProfileBox" Height="42" SelectionChanged="ProfileBox_Changed"/>
                                    <TextBlock x:Name="ProfileInfo" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="StatusText" Text="Готов к запуску" Foreground="{StaticResource Muted}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Margin="0,0,0,16"/>
                        <Button x:Name="PlayBtn" Style="{StaticResource PrimaryButton}" Content="ИГРАТЬ" Click="Play_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ===== ПРОФИЛИ ===== -->
                <Grid x:Name="PageProfiles" Grid.Row="1" Margin="40,4,36,28" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource H1}" Text="Профили"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18" Text="Профиль - это своя версия игры, свои моды и миры. Собери для каждого настроения свой уголок."/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" Content="＋ Новый профиль" Click="NewProfile_Click" Margin="0,8,4,0"/>
                            <ListBox x:Name="ProfileList" Background="Transparent" BorderThickness="0" SelectionChanged="ProfileList_Changed">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="2" CornerRadius="4" Padding="14,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Pixel}" FontSize="16"/>
                                                <TextBlock Text="{Binding Loader}" Foreground="{StaticResource Muted}" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        <Border Grid.Column="2" Style="{StaticResource CardBox}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="НАЗВАНИЕ"/>
                                <TextBox x:Name="PName" Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Label}" Text="ВЕРСИЯ MINECRAFT"/>
                                        <ComboBox x:Name="PVersion" Height="42" SelectionChanged="LoaderOrVersion_Changed"/>
                                    </StackPanel>
                                    <CheckBox x:Name="SnapshotsCheck" Grid.Column="2" Content="Снапшоты" VerticalAlignment="Bottom" Margin="0,0,0,11" Click="Snapshots_Click"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Label}" Text="ЗАГРУЗЧИК"/>
                                <Border Background="{StaticResource Field}" CornerRadius="4" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,4"
                                        BorderBrush="{StaticResource Line}" BorderThickness="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="LoaderFabric" Style="{StaticResource SegButton}" Content="Fabric (моды, скины)" Click="LoaderOrVersion_Changed"/>
                                        <RadioButton x:Name="LoaderVanilla" Style="{StaticResource SegButton}" Content="Vanilla" Click="LoaderOrVersion_Changed"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="LoaderHint" Style="{StaticResource Hint}" Margin="0,0,0,14" Text="Для модов и скинов нужен Fabric - лаунчер поставит его сам."/>
                                <Grid>
                                    <TextBlock Style="{StaticResource Label}" Text="ОПЕРАТИВНАЯ ПАМЯТЬ"/>
                                    <TextBlock x:Name="PRamLabel" HorizontalAlignment="Right"/>
                                </Grid>
                                <CheckBox x:Name="PRamOwn" Content="Своя память для этого профиля (иначе - из настроек)" Margin="0,0,0,8" Click="PRamOwn_Click"/>
                                <Slider x:Name="PRam" Minimum="1024" Maximum="16384" TickFrequency="512" IsSnapToTickEnabled="True" ValueChanged="PRam_Changed"/>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Style="{StaticResource GhostButton}" Content="Сохранить" Click="SaveProfile_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Открыть папку" Margin="10,0,0,0" Click="OpenProfileFolder_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Удалить" Margin="10,0,0,0" Foreground="{StaticResource Danger}" Click="DeleteProfile_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== МОДЫ ===== -->
                <Grid x:Name="PageMods" Grid.Row="1" Margin="40,4,36,28" Visibility="Collapsed" AllowDrop="True" Drop="Mods_Drop">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource H1}" Text="Моды"/>
                        <TextBlock x:Name="ModsProfileText" Style="{StaticResource Hint}" Margin="0,4,0,14"/>
                        <Border Background="{StaticResource Field}" CornerRadius="4" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,14"
                                BorderBrush="{StaticResource Line}" BorderThickness="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabInstalled" Style="{StaticResource SegButton}" Content="Установленные" IsChecked="True" Checked="ModsTab_Click"/>
                                <RadioButton x:Name="TabModrinth" Style="{StaticResource SegButton}" Content="Поиск Modrinth" Checked="ModsTab_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid x:Name="InstalledPanel" Grid.Row="1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Style="{StaticResource GhostButton}" Content="＋ Добавить .jar" Click="AddMods_Click"/>
                            <Button Style="{StaticResource GhostButton}" Content="Открыть папку модов" Margin="10,0,0,0" Click="OpenMods_Click"/>
                            <TextBlock Style="{StaticResource Hint}" Text="или перетащи файлы в окно" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="ModList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="2" CornerRadius="4" Padding="16,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="ModToggle_Click"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="14,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Size}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                <Button Grid.Column="3" Style="{StaticResource WinButton}" Width="32" Height="28" Content="✕" Click="ModDelete_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="ModsEmpty" Text="Модов пока нет - найди что-нибудь в Modrinth" Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                        </Grid>
                    </Grid>

                    <Grid x:Name="ModrinthPanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" KeyDown="SearchBox_KeyDown"/>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Найти" Margin="10,0,0,0" Click="Search_Click"/>
                        </Grid>
                        <TextBlock x:Name="SearchStatus" Grid.Row="1" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                        <ListBox x:Name="HitList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="2" CornerRadius="4" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding IconUrl}" Width="44" Height="44" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1" Margin="4,0,12,0">
                                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Pixel}" FontSize="16"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" MaxHeight="34"/>
                                                <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0">
                                                    <Run Text="{Binding Author}"/><Run Text="  ·  ⬇ "/><Run Text="{Binding Downloads}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Установить" VerticalAlignment="Center"
                                                    Tag="{Binding ProjectId}" Click="Install_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

                <!-- ===== СКИНЫ ===== -->
                <Grid x:Name="PageSkins" Grid.Row="1" Margin="40,4,36,28" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource H1}" Text="Скины и плащи"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14" Text="Выбери систему скинов. Переключаться между ними можно в любой момент."/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardBox}" VerticalAlignment="Top">
                            <StackPanel>
                                <Border Background="{StaticResource Field}" CornerRadius="4" Height="330" Margin="0,0,0,12" ClipToBounds="True">
                                    <Image x:Name="SkinImg" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" Margin="10"/>
                                </Border>
                                <Border Background="{StaticResource Field}" CornerRadius="4" Padding="3" HorizontalAlignment="Center" Margin="0,0,0,10"
                                        BorderBrush="{StaticResource Line}" BorderThickness="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ViewFront" Style="{StaticResource SegButton}" Content="Спереди" IsChecked="True" Checked="View_Click"/>
                                        <RadioButton x:Name="ViewBack" Style="{StaticResource SegButton}" Content="Сзади" Checked="View_Click"/>
                                    </StackPanel>
                                </Border>
                                <CheckBox x:Name="SlimCheck" Content="Тонкие руки (Alex)" HorizontalAlignment="Center" Click="Slim_Click"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="{StaticResource Field}" CornerRadius="4" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,10"
                                        BorderBrush="{StaticResource Line}" BorderThickness="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SysCss" Style="{StaticResource SegButton}" Content="C.S.S." Tag="Css" Checked="System_Click"/>
                                        <RadioButton x:Name="SysOfficial" Style="{StaticResource SegButton}" Content="Официальная" Tag="Official" Checked="System_Click"/>
                                        <RadioButton x:Name="SysEly" Style="{StaticResource SegButton}" Content="Ely.by" Tag="ElyBy" Checked="System_Click"/>
                                        <RadioButton x:Name="SysTl" Style="{StaticResource SegButton}" Content="TLauncher" Tag="TLauncher" Checked="System_Click"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="SysDesc" Style="{StaticResource Hint}" Margin="0,0,0,14"/>

                                <StackPanel x:Name="CssPanel">
                                    <Border Style="{StaticResource CardBox}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Text="СКИНЫ"/>
                                            <ItemsControl x:Name="SkinTiles" ItemTemplate="{StaticResource LibTile}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource GhostButton}" Content="＋ Импорт PNG" Click="ImportSkin_Click"/>
                                                <Button Style="{StaticResource GhostButton}" Content="Удалить выбранный" Margin="10,0,0,0" Click="DeleteSkin_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardBox}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Text="ПЛАЩИ"/>
                                            <ItemsControl x:Name="CapeTiles" ItemTemplate="{StaticResource LibTile}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource GhostButton}" Content="＋ Импорт плаща" Click="ImportCape_Click"/>
                                                <Button Style="{StaticResource GhostButton}" Content="Без плаща" Margin="10,0,0,0" Click="NoCape_Click"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="Плащ виден сзади, как в Bedrock. Сторонний плащ - PNG 64x32."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border x:Name="SitePanel" Style="{StaticResource CardBox}" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Label}" Text="НАЙТИ СКИН ПО НИКУ"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="LookupBox" KeyDown="LookupBox_KeyDown"/>
                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Найти" Margin="10,0,0,0" Click="Lookup_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="LookupStatus" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button x:Name="SaveLookupBtn" Style="{StaticResource GhostButton}" Content="Сохранить в библиотеку C.S.S." Click="SaveLookup_Click" IsEnabled="False"/>
                                            <Button x:Name="UploadBtn" Style="{StaticResource GhostButton}" Content="Загрузить в мой аккаунт Minecraft" Margin="10,0,0,0" Click="Upload_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="SkinsFabricHint" Style="{StaticResource Hint}" Foreground="{DynamicResource Accent}" Margin="0,0,0,12"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ===== НАСТРОЙКИ ===== -->
                <ScrollViewer x:Name="PageSettings" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40,4,36,28">
                        <TextBlock Style="{StaticResource H1}" Text="Настройки"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18" Text="Всё самое нужное - без лишних сложностей. Изменения сохраняются сразу."/>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Внешний вид" Margin="0,0,0,12"/>
                                <TextBlock Style="{StaticResource Label}" Text="ТЁПЛЫЙ АКЦЕНТ"/>
                                <StackPanel Orientation="Horizontal" x:Name="AccentRow" Margin="0,0,0,14"/>
                                <CheckBox x:Name="AnimCheck" Content="Живой фон: звёзды и костёр" Click="Anim_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Игра" Margin="0,0,0,12"/>
                                <Grid>
                                    <TextBlock Style="{StaticResource Label}" Text="ОПЕРАТИВНАЯ ПАМЯТЬ"/>
                                    <TextBlock x:Name="RamLabel" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <CheckBox x:Name="AutoRamCheck" Content="Подобрать автоматически под мой ПК" Margin="0,0,0,8" Click="AutoRam_Click"/>
                                <Slider x:Name="RamSlider" Minimum="1024" Maximum="16384" TickFrequency="512" IsSnapToTickEnabled="True" ValueChanged="Ram_Changed"/>
                                <TextBlock x:Name="RamHint" Style="{StaticResource Hint}" Margin="0,4,0,16"/>

                                <TextBlock Style="{StaticResource Label}" Text="ОКНО ИГРЫ"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBox x:Name="WidthBox" Width="90" TextAlignment="Center"/>
                                    <TextBlock Text="×" VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource Muted}"/>
                                    <TextBox x:Name="HeightBox" Width="90" TextAlignment="Center"/>
                                    <ComboBox x:Name="SizePreset" Width="170" Height="38" Margin="14,0,0,0" SelectionChanged="SizePreset_Changed"/>
                                </StackPanel>
                                <CheckBox x:Name="FullscreenCheck" Content="Полноэкранный режим" Margin="0,0,0,16"/>

                                <TextBlock Style="{StaticResource Label}" Text="АВТОВХОД НА СЕРВЕР (адрес[:порт], необязательно)"/>
                                <TextBox x:Name="ServerBox" Margin="0,0,0,16"/>

                                <TextBlock Style="{StaticResource Label}" Text="JAVA (пусто = лаунчер скачает нужную сам)"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="JavaBox"/>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Обзор…" Margin="10,0,0,0" Click="BrowseJava_Click"/>
                                </Grid>

                                <TextBlock Style="{StaticResource Label}" Text="ПРОФИЛЬ ПРОИЗВОДИТЕЛЬНОСТИ JVM"/>
                                <ComboBox x:Name="JvmPreset" Height="42" Margin="0,0,0,12"/>
                                <TextBlock Style="{StaticResource Label}" Text="ДОПОЛНИТЕЛЬНЫЕ ПАРАМЕТРЫ JVM"/>
                                <TextBox x:Name="JvmBox"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Лаунчер" Margin="0,0,0,12"/>
                                <TextBlock Style="{StaticResource Label}" Text="ПОСЛЕ ЗАПУСКА ИГРЫ"/>
                                <ComboBox x:Name="BehaviorBox" Height="42" Margin="0,0,0,14"/>
                                <CheckBox x:Name="ReopenCheck" Content="Возвращать лаунчер, когда игра закрылась" Margin="0,0,0,10"/>
                                <CheckBox x:Name="LogCheck" Content="Сохранять журнал игры (помогает найти причину вылета)" Margin="0,0,0,10"/>
                                <CheckBox x:Name="SkinsCheck" Content="Подключать скины и плащи в игре (Fabric + CustomSkinLoader)"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Обновления" Margin="0,0,0,12"/>
                                <CheckBox x:Name="AutoUpdCheck" Content="Проверять обновления при запуске" Margin="0,0,0,12"/>
                                <TextBlock Style="{StaticResource Label}" Text="ИСТОЧНИК (https://…/latest.json или github:владелец/репозиторий)"/>
                                <TextBox x:Name="UpdSourceBox" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource GhostButton}" Content="Проверить сейчас" Click="CheckNow_Click"/>
                                    <TextBlock x:Name="UpdStatus" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Данные" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource GhostButton}" Content="Папка лаунчера" Click="OpenRoot_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Журналы игры" Margin="10,0,0,0" Click="OpenLogs_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Очистить журналы" Margin="10,0,0,0" Click="ClearLogs_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Сбросить настройки" Margin="10,0,0,0" Foreground="{StaticResource Danger}" Click="Reset_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="DataInfo" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Assets/logo.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AboutTitle" Style="{StaticResource H2}" Text="Core Launcher"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Сначала уют, потом игра. Это демо - ошибки и пожелания приветствуются."/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Minecraft - торговая марка Mojang. Лаунчер не связан с Mojang и Microsoft."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== Приветствие при первом запуске ===== -->
            <Grid x:Name="Welcome" Grid.ColumnSpan="2" Background="#F0121B52" Visibility="Collapsed">
                <Border Style="{StaticResource CardBox}" Width="460" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">
                    <StackPanel>
                        <Image Source="Assets/logo.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,0,14"/>
                        <TextBlock Text="Добро пожаловать в Core" Style="{StaticResource H1}" FontSize="26" TextAlignment="Center"/>
                        <TextBlock Text="Сначала уют, потом игра" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource Pixel}" FontSize="16"
                                   TextAlignment="Center" Margin="0,4,0,20"/>
                        <TextBlock Style="{StaticResource Label}" Text="КАК ТЕБЯ ЗОВУТ В ИГРЕ?"/>
                        <TextBox x:Name="WelcomeNick" MaxLength="16" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,20"
                                   Text="Остальное лаунчер настроит сам: память под твой ПК, Java и Fabric. Ник и всё остальное можно поменять позже."/>
                        <Button Style="{StaticResource PrimaryButton}" Content="ПОЕХАЛИ" Click="WelcomeGo_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>





